<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE permissions.
         neverForLocation on BLUETOOTH_SCAN: BikeOS never derives physical
         location from scan results, so BLE scanning itself doesn't need
         ACCESS_FINE_LOCATION on API 31+. ACCESS_FINE_LOCATION is declared
         below unconditionally (no maxSdkVersion cap) anyway, because
         Phase K's hardware-free mode uses real GPS via
         FusedLocationProviderClient regardless of API level. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Real GPS for Phase K hardware-free mode (PhoneSensorSource), not
         just implied by BLE scan - requested at runtime from Settings/
         ClusterBoot, never assumed granted. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Normal permission (no runtime prompt) - haptic feedback for the
         engine-start boot animation. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Runtime (dangerous) permissions for the Calls widget - requested
         from DashboardScreen, not assumed granted. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Runtime (dangerous) permission on API 33+ only, requested from
         Home/Settings - reminder notifications (Phase E). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BikeOSApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="BikeOS"
        android:theme="@style/Theme.BikeOS"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BikeOS.Splash"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- Portrait by default - only the Dashboard/cluster and its
                 boot sequence force landscape, programmatically, since
                 that's the only screen meant to be viewed handlebar-
                 mounted sideways. See core/common/LandscapeOnly.kt.
                 windowSoftInputMode="adjustResize": belt-and-suspenders
                 for the keyboard-covers-fields bug fix (see
                 docs/24_PHASE_I_UI_OVERHAUL.md) - the actual fix on
                 edge-to-edge (enableEdgeToEdge() in this Activity) is
                 each scrollable form's own .imePadding() modifier, since
                 adjustResize/adjustPan are largely superseded once
                 decorFitsSystemWindows is false, but this costs nothing
                 and helps on older/OEM edge cases. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required for the Music widget - see BikeOSNotificationListenerService kdoc
             for why a notification listener is needed just to read media session state. -->
        <service
            android:name=".data.media.BikeOSNotificationListenerService"
            android:exported="true"
            android:label="BikeOS Music Widget"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- On-demand WorkManager initialization: BikeOSApplication implements
             Configuration.Provider (supplies a HiltWorkerFactory so
             ReminderWorker can be constructor-injected - see
             BikeOSApplication.kt), so the library's own default
             WorkManagerInitializer (which would build an unconfigured
             WorkManager with no knowledge of Hilt-created workers) must be
             removed from the merged manifest. This is the official AndroidX
             Startup way to do that: override the WorkManagerInitializer
             meta-data entry contributed by the work-runtime-ktx library's
             manifest and mark it tools:node="remove" during manifest
             merging. Removing this (instead of just disabling lint) is
             required - lintVitalRelease fails release builds otherwise,
             and the underlying issue (two competing WorkManager configs)
             is real, not just a lint nag. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
